# expect: sys stdlib test passed

import sys

let plat = sys.platform()
assert(plat == "linux" or plat == "wasi" or plat == "wasm" or plat == "darwin" or plat == "windows")



let args = sys.args()
assert(len(args) >= 1)

let p = sys.env("PATH")
assert(p != null)

let missing = sys.env("NON_EXISTENT_VAR_987654321")
assert(missing == null)

say "sys stdlib test passed"
