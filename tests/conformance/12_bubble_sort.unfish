# expect: [1, 2, 5, 8, 9]

function bubble_sort(arr):
    let n = len(arr)
    let i = 0
    while i < n:
        let j = 0
        while j < n - i - 1:
            if arr[j] > arr[j + 1]:
                let temp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
            j = j + 1
        i = i + 1
    return arr

let list = [5, 2, 8, 1, 9]
say bubble_sort(list)
