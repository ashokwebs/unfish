# Further closure edge cases: per-iteration for-loop closures, recursive
# local closures with self-mutation, 4-level-deep transitive capture with
# mutation, and a closure over a struct-pattern-bound field.
# expect: 0
# expect: 1
# expect: 2
# expect: 5
# expect: 101
# expect: 34

function make_closures():
    let fns = []
    for i in range(3):
        function get():
            return i
        push(fns, get)
    return fns

let closures = make_closures()
say(closures[0]())
say(closures[1]())
say(closures[2]())

function counter_factory():
    let n = 0
    function step(k):
        if k <= 0:
            return n
        n = n + 1
        return step(k - 1)
    return step

let s = counter_factory()
say(s(5))

function level0():
    let v = 1
    function level1():
        function level2():
            function level3():
                v = v + 100
                return v
            return level3()
        return level2()
    return level1()

say(level0())

struct Pair:
    a: Number
    b: Number

function inspect(p):
    match p:
        when Pair(x, y):
            function combo():
                return x * 10 + y
            return combo()
        else:
            return -1

say(inspect(Pair(3, 4)))
