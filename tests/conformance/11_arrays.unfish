# expect: 10
# expect: 30
# expect: 99
# expect: 4
# expect: 50
# expect: 50
# expect: 3
# expect: 42
# expect: U
# expect: h

# 1. Array creation and indexing
let nums = [10, 20, 30]
say nums[0]
say nums[-1]

# 2. Index assignment
nums[1] = 99
say nums[1]

# 3. push and pop
push(nums, 50)
say len(nums)
say nums[3]
let popped = pop(nums)
say popped
say len(nums)

# 4. Multi-dimensional nested arrays
let grid = [[1, 2], [3, 42]]
say grid[1][1]

# 5. String indexing
let lang = "Unfish"
say lang[0]
say lang[-1]
