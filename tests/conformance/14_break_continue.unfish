# expect: 0
# expect: 1
# expect: 2
# expect: loop finished
# expect: 1
# expect: 3
# expect: 5
# expect: found cherry
# expect: 0
# expect: 2
# expect: 4
# expect: for-continue done
# expect: 1
# expect: 2
# expect: 4
# expect: 5
# expect: repeat-continue done

# 1. break in while
let x = 0
while true:
    if x == 3:
        break
    say x
    x = x + 1
say "loop finished"

# 2. continue in while (print odd numbers under 6)
let y = 0
while y < 6:
    y = y + 1
    if y % 2 == 0:
        continue
    say y

# 3. break in for-in
let items = ["apple", "banana", "cherry", "date"]
for item in items:
    if item == "cherry":
        say "found cherry"
        break

# 4. continue in for-in (print even numbers under 5; this was an infinite
# loop in the bytecode VM, since `continue` skipped the loop's hidden
# index advance)
for i in range(5):
    if i % 2 != 0:
        continue
    say i
say "for-continue done"

# 5. continue in repeat (this used to silently run one extra iteration in
# the bytecode VM per `continue`, since it skipped the hidden counter
# advance)
let n = 0
repeat 5 times:
    n = n + 1
    if n == 3:
        continue
    say n
say "repeat-continue done"
