{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Unfish",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.unfish",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.interpolated.triple.unfish",
          "begin": "[fF]\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.unfish",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.line.unfish",
              "begin": "(?<!\\{)\\{(?!\\{)",
              "end": "\\}",
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        },
        {
          "name": "string.interpolated.double.unfish",
          "begin": "[fF]\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.unfish",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.line.unfish",
              "begin": "(?<!\\{)\\{(?!\\{)",
              "end": "\\}",
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.triple.double.unfish",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.unfish",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.unfish",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.unfish",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.unfish",
          "match": "\\b(let|function|return|if|else|while|repeat|times|for|in|break|continue|try|catch|import|from|as|struct|enum|match|when)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.unfish",
          "match": "\\b(Number|String|Boolean|Array|Map|Function|Null|Any|Error|Buffer|Channel|Fiber)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.unfish",
          "match": "\\b(true|false|null|PI|E|INFINITY)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.unfish",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.unfish",
          "match": "\\b(say|print|len|type_of|push|pop|keys|values|has_key|delete|map|filter|reduce|sort|reverse|find|every|some|range|abs|sqrt|floor|ceil|round|min|max|pow|log|sin|cos|tan|random|random_int|trim|to_upper|to_lower|contains|starts_with|ends_with|char_at|to_number|to_string|repeat_string|substring|index_of|split|join|replace|buffer|buffer_from_string|buffer_to_string|buffer_size|buffer_get|buffer_set|buffer_fill|buffer_slice|buffer_read_u16_le|buffer_write_u16_le|buffer_read_u32_le|buffer_write_u32_le|buffer_read_i32_le|buffer_write_i32_le|u8|i8|u16|i16|u32|i32|band|bor|bxor|bnot|shl|shr|sar|to_hex|from_hex|buffer_to_hex|buffer_from_hex|spawn|yield|channel|send|recv|close_channel|run_scheduler|clock|assert|error|inspect)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(function)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.unfish" },
            "2": { "name": "entity.name.function.unfish" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.unfish",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.comparison.unfish",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.unfish",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.assignment.unfish",
          "match": "(=)"
        }
      ]
    }
  },
  "scopeName": "source.unfish"
}
