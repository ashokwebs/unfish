{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Unfish",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.unfish",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.unfish",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.unfish",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.unfish",
          "match": "\\b(let|function|return|if|else|while|repeat|for|in|break|continue|try|catch|import|from|as|struct|match|when)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.unfish",
          "match": "\\b(Number|String|Boolean|Array|Map|Function|Null|Any|Error)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.unfish",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.unfish",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.unfish",
          "match": "\\b(say|print|len|type_of|push|pop|keys|values|has_key|delete|abs|sqrt|floor|ceil|round|min|max|pow)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(function)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.unfish" },
            "2": { "name": "entity.name.function.unfish" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.unfish",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.comparison.unfish",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.unfish",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.assignment.unfish",
          "match": "(=)"
        }
      ]
    }
  },
  "scopeName": "source.unfish"
}
