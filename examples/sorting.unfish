# Sorting Algorithms in Unfish

function bubble_sort(arr):
    let n = len(arr)
    let i = 0
    while i < n:
        let j = 0
        while j < n - i - 1:
            if arr[j] > arr[j + 1]:
                let tmp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = tmp
            j = j + 1
        i = i + 1
    return arr

let unsorted = [64, 34, 25, 12, 22, 11, 90]
say "Unsorted: " + unsorted

let sorted = bubble_sort(unsorted)
say "Sorted:   " + sorted
